# ============================================================
# AI Nutrition Analyzer - biến môi trường
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên git.
# ============================================================

# --- Bắt buộc: khóa ký cookie phiên ---
# Sinh khóa: .venv/Scripts/python.exe -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Ứng dụng ---
APP_NAME=AI Nutrition Analyzer
DEBUG=false
HOST=127.0.0.1
PORT=8000

# --- Database (để trống = dùng SQLite tại data/nutrition.db) ---
DATABASE_URL=

# --- Upload ảnh ---
MAX_UPLOAD_MB=8
IMAGE_STORAGE_DAYS=30

# --- Ollama / Qwen ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_TIMEOUT_S=120
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=400
# qwen3.5 là model "thinking": đặt false để không đốt hết token vào phần suy luận
OLLAMA_THINK=false

# --- USDA FoodData Central (tùy chọn, chỉ cần nếu dùng API thay vì file bulk) ---
# Đăng ký miễn phí tại https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=
